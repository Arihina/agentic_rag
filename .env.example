# === Копия для настройки ===
# cp .env.example agentic_rag.env  и правь под свою среду.
# Все поля читаются через префикс AGENTIC_RAG_.

# --- сеть -------------------------------------------------------------
AGENTIC_RAG_HOST=127.0.0.1
AGENTIC_RAG_PORT=8020
AGENTIC_RAG_RELOAD=false
AGENTIC_RAG_LOG_LEVEL=info
AGENTIC_RAG_TIMEOUT_KEEP_ALIVE=300

# --- OpenSearch (только чтение) ---------------------------------------
AGENTIC_RAG_OPENSEARCH_URL=http://localhost:9200
# AGENTIC_RAG_OPENSEARCH_USER=admin
# AGENTIC_RAG_OPENSEARCH_PASSWORD=***
AGENTIC_RAG_INDEX_NAME=kb-v2
AGENTIC_RAG_OPENSEARCH_TIMEOUT=30.0

# --- LLM (Ollama) -----------------------------------------------------
AGENTIC_RAG_OLLAMA_URL=http://localhost:11434
AGENTIC_RAG_OLLAMA_TIMEOUT=300.0
# Роли одной модели — можно развести на разные для экономии на rewriter/eval:
AGENTIC_RAG_LLM_MODEL_REWRITER=qwen3:8b
AGENTIC_RAG_LLM_MODEL_MULTI_QUERY=qwen3:8b
AGENTIC_RAG_LLM_MODEL_EVAL=qwen3:8b
AGENTIC_RAG_LLM_MODEL_ANSWER=qwen3:8b
# В проде на A100: qwen3.6:35b для answer, qwen3:8b для остальных.
AGENTIC_RAG_LLM_NUM_CTX=8192
AGENTIC_RAG_LLM_TEMPERATURE_REWRITER=0.0
AGENTIC_RAG_LLM_TEMPERATURE_EVAL=0.0
AGENTIC_RAG_LLM_TEMPERATURE_MULTI_QUERY=0.7
# Температура answer — из конфига набора (rag_set.temperature).
AGENTIC_RAG_LLM_RETRY_ATTEMPTS=3
AGENTIC_RAG_LLM_RETRY_BACKOFF=1.0

# --- ingestion client -------------------------------------------------
# /embed и /v1/internal/* — на ВНУТРЕННЕМ порту 8012 (не 8011).
AGENTIC_RAG_INGEST_INTERNAL_URL=http://127.0.0.1:8012
AGENTIC_RAG_INGEST_TIMEOUT=30.0

# --- поиск ------------------------------------------------------------
# final_top_k — из конфига набора; здесь только глубина каждой ветки:
AGENTIC_RAG_BM25_TOP_K=50
AGENTIC_RAG_KNN_TOP_K=50
AGENTIC_RAG_SPARSE_TOP_K=50
AGENTIC_RAG_PRIMARY_WEIGHT=2.0

# --- multi-query ------------------------------------------------------
AGENTIC_RAG_MULTI_QUERY_VARIANTS_COUNT=3

# --- агентский цикл ---------------------------------------------------
AGENTIC_RAG_MAX_ITERATIONS=3

# --- история чата -----------------------------------------------------
AGENTIC_RAG_TOKENIZER_REPO=Qwen/Qwen3-8B
AGENTIC_RAG_HISTORY_TOKEN_LIMIT=6000
# В проде: strict
AGENTIC_RAG_HISTORY_OVERFLOW=truncate

# --- SSE --------------------------------------------------------------
AGENTIC_RAG_SSE_HEARTBEAT_INTERVAL=15.0

# --- Postgres (появится в 2.3) ----------------------------------------
AGENTIC_RAG_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/agentic_rag
AGENTIC_RAG_DB_POOL_SIZE=10
AGENTIC_RAG_DB_MAX_OVERFLOW=20

# --- системные промпты (можно многострочно через .env-парсер) ---------
# AGENTIC_RAG_ANSWER_SYSTEM_PROMPT="..."
# AGENTIC_RAG_REWRITER_SYSTEM_PROMPT="..."
# AGENTIC_RAG_EVAL_SYSTEM_PROMPT="..."
# AGENTIC_RAG_MULTI_QUERY_SYSTEM_PROMPT_TEMPLATE="...{n}..."